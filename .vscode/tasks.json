{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Portfolio: Web visible",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "test",
        "-c",
        "portfolio.config.ts",
        "--project=web",
        "--headed",
        "--workers=1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Portfolio: Web debug",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "test",
        "-c",
        "portfolio.config.ts",
        "--project=web",
        "--debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Portfolio: API",
      "type": "process",
      "command": "node",
      "args": [
        "node_modules/@playwright/test/cli.js",
        "test",
        "-c",
        "portfolio.config.ts",
        "--project=api"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Portfolio: Install Chromium",
      "type": "process",
      "command": "node",
      "args": ["node_modules/@playwright/test/cli.js", "install", "chromium"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
