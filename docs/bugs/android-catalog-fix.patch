+
+// Ensure generated Google Services resources exist before AGP maps source sets.
+tasks.configureEach { task ->
+    if (task.name == "mapDebugSourceSetPaths") {
+        task.dependsOn("processDebugGoogleServices")
+    }
+}
+
+// Restricted-environment fallback: reuse javac output only after bytecode verification.
+if (project.hasProperty('reuseCompiledClasses')) {
+    def compiledCatalog = file("$buildDir/intermediates/javac/debug/classes/com/saucelabs/mydemoapp/android/view/fragments/ProductCatalogFragment.class")
+    if (!compiledCatalog.isFile()) throw new GradleException('Compile sources before requesting reuseCompiledClasses')
+    tasks.withType(JavaCompile).configureEach {
+        if (name == 'compileDebugJavaWithJavac') onlyIf { false }
+    }
+}
